{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hnxj.github.io/labyrinth/registry.schema.json",
  "title": "HNXJ Labyrinth Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updated", "apps"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "hnxj-labyrinth-registry-v1"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/app" }
    }
  },
  "definitions": {
    "status": {
      "type": "string",
      "enum": ["live", "fixture", "degraded", "archived", "unavailable", "planned"]
    },
    "kind": {
      "type": "string",
      "enum": ["application", "surface", "experiment", "catalog"]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "status", "kind", "provenance", "updated"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "format": "uri" },
        "image": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "reason": { "type": "string" },
        "kind": { "$ref": "#/definitions/kind" },
        "provenance": { "type": "string", "minLength": 1 },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["live", "fixture", "degraded", "archived"] } },
            "required": ["status"]
          },
          "then": { "required": ["href", "reason"] }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["unavailable", "planned"] } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
